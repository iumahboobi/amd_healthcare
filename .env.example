# ——————————————————————————————————————————————————————————————————
# Afghan Medical Diaspora — backend configuration
# Copy this file to `.env` (in the PROJECT ROOT, next to index.html)
# and fill in your real values. `.env` is gitignored — NEVER commit it.
# ——————————————————————————————————————————————————————————————————

# ——————————————————————————————————————————————————————————————————
# HTTP Server
# ——————————————————————————————————————————————————————————————————
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000

# ——————————————————————————————————————————————————————————————————
# Database
#   DB_CLIENT options:
#     better-sqlite3  → local SQLite file (default, zero setup, works today)
#     pg              → PostgreSQL  (set DATABASE_URL below)
#     mysql2          → MySQL/MariaDB (set DATABASE_URL below)
# ——————————————————————————————————————————————————————————————————
DB_CLIENT=better-sqlite3
# DB_FILENAME — leave commented/blank to use default <project-root>/data/app.db
# If you must set it manually, use an ABSOLUTE path to avoid cwd surprises.
# DB_FILENAME=E:\Projects\Afghan Medical Diaspora\data\app.db

# PostgreSQL / MySQL — only required if DB_CLIENT != better-sqlite3
# DATABASE_URL=postgres://user:password@localhost:5432/amd
# DATABASE_URL=mysql2://user:password@localhost:3306/amd

# ——————————————————————————————————————————————————————————————————
# SMTP — outgoing email (for notifications + confirmations)
#
# Use the SMTP credentials from your mailbox / hosting provider.
#
# Gmail: create an "App Password" at myaccount.google.com → Security
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=you@gmail.com   SMTP_PASS=<16-char app password>
#
# Hotmail / Outlook.com / Live.com (Microsoft personal accounts):
#   1. Enable 2-Step Verification on your Microsoft account FIRST
#      (https://account.microsoft.com/security → Advanced security)
#   2. Create an "App password" at https://account.microsoft.com/security
#      → "App passwords" → Create new app password → copy the 16-char code
#   3. Paste that 16-char app password into SMTP_PASS below (NOT your login pw)
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false   (port 587 uses STARTTLS via requireTLS, NOT implicit TLS)
#
# Office365 business / Exchange:
#   SMTP_HOST=smtp.office365.com   SMTP_PORT=587
#
# Domain hosting (typical cPanel / Plesk / Namecheap / Siteground):
#   SMTP_HOST=mail.afghanmedicaldiaspora.org
#   SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=join@afghanmedicaldiaspora.org   SMTP_PASS=<mailbox password>
# ——————————————————————————————————————————————————————————————————
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=join@afghanmedicaldiaspora.org
SMTP_PASS=changeme

# "From:" address on outgoing emails. Should match SMTP_USER domain.
MAIL_FROM_NAME="Afghan Medical Diaspora"
MAIL_FROM_ADDRESS=join@afghanmedicaldiaspora.org
# Default reply-to for user confirmations
MAIL_REPLY_TO=join@afghanmedicaldiaspora.org

# ——————————————————————————————————————————————————————————————————
# Who receives a notification email when a form is submitted?
# ——————————————————————————————————————————————————————————————————
# Main organisation mailbox (company inbox — the one you asked for)
ORG_NOTIFY_EMAIL=info@afghanmedicaldiaspora.org

# Optional 2nd admin CC — leave EMPTY to disable (just delete the value)
ORG_NOTIFY_CC=

# ——————————————————————————————————————————————————————————————————
# Email toggles — keep as true unless debugging
# ——————————————————————————————————————————————————————————————————
SEND_SUBMITTER_CONFIRMATION=true
SEND_ORG_NOTIFICATION=true
